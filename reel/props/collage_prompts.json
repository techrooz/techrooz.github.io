 "lines": [
  {
   "text": "فرض کن یه کارمند فوق‌العاده استخدام کردی. فقط یه مشکل داره: هیچ‌وقت سؤال نمی‌پرسه!",
   "start": 0.0,
   "end": 5.36
  },
  {
   "text": "بهش می‌گی یه کپشن بنویس. اونم یه جمله‌ی کلیشه‌ای تحویلت می‌ده.",
   "start": 5.5,
   "end": 9.49
  },
  {
   "text": "آخه نمی‌دونه تو کی هستی، برای کی می‌نویسی، و چه شکلی می‌خوای.",
   "start": 9.63,
   "end": 14.05
  },
  {
   "text": "پس اول بهش بگو چه نقشی داره. مثلاً کپی‌رایتر حرفه‌ای.",
   "start": 14.19,
   "end": 18.51
  },
  {
   "text": "بعد بگو مخاطبت کیه. مثلاً جوون‌های علاقه‌مند به تکنولوژی.",
   "start": 18.65,
   "end": 22.58
  },
  {
   "text": "بعد قالب جواب رو بگو. سه خط، با ایموجی، و آخرش یه سؤال.",
   "start": 22.72,
   "end": 28.45
  },
  {
   "text": "و آخرین جمله‌ای که همه‌چیز رو عوض می‌کنه: اگه چیزی کم داری، قبل از جواب از من بپرس.",
   "start": 28.75,
   "end": 35.5
  },
  {
   "text": "با همین چهار تا، جواب‌هات حسابی فرق می‌کنه. امتحانش کن.",
   "start": 35.6,
   "end": 39.93
  },
  {
   "text": "متن کامل این پرامپت رو می‌خوای؟ فقط بنویس: پرامپت.",
   "start": 40.07,
   "end": 43.91
  }
