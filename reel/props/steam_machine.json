"pops":[{"text":"Steam Machine","start":4.7,"dur":1.8},{"text":"پرفروش‌ترین 🔥","start":27.5,"dur":2.6},{"text":"۱٬۰۴۹ دلار 💸","start":33.2,"dur":3.0},{"text":"ارزششو داره؟","start":37.9,"dur":1.5}],
"lines":[
{"text":"ولو یه کنسول ساخته که می‌تونه پلی‌استیشن رو بترسونه!","start":0.1,"end":4.2},
{"text":"اسمش استیم ماشینه.","start":4.63,"end":6.1},
{"text":"یه کامپیوتر گیمینگ کوچیک، که کل کتابخونه‌ی استیمت رو، مستقیم میاره روی تلویزیون.","start":6.51,"end":13.2},
{"text":"حالا چرا همه دارن درباره‌اش حرف می‌زنن؟","start":13.98,"end":16.4},
{"text":"چون بازی‌های سنگین کامپیوتری رو، بدون دردسر نصب و تنظیم، مثل یه کنسول اجرا می‌کنه.","start":17.0,"end":24.1},
{"text":"از تیرماه عرضه شده، و همین الان جزو پرفروش‌ترین‌های فروشگاه استیمه.","start":24.76,"end":30.6},
{"text":"ولی یه مشکل بزرگ داره:","start":31.14,"end":32.7},
{"text":"قیمتش، هزار و چهل و نه دلاره!","start":33.13,"end":36.0},
{"text":"پس سؤال اینه:","start":36.56,"end":37.5},
{"text":"ارزشش رو داره؟","start":37.93,"end":39.1},
{"text":"یا هنوز، کنسول پادشاه بازیه؟","start":39.54,"end":42.4},
{"text":"نظرت رو بگو، و برای خبرهای داغ دنیای گیم و تکنولوژی، تک‌روز رو دنبال کن.","start":43.04,"end":49.6}]}
