  {
   "text": "آیفون تاشوی دو هزار دلاری اپل، چند ساعت بعد از خرید ترک خورد!",
   "start": 0.0,
   "end": 4.27
  },
  {
   "text": "اسمش آیفون دوئوئه. اولین گوشی تاشوی اپل، که تازه اومده بازار.",
   "start": 4.41,
   "end": 9.41
  },
  {
   "text": "چند نفر از خریدارها گفتن صفحه‌ی داخلی، دقیقاً روی خطِ تا، ترک خورده.",
   "start": 9.55,
   "end": 14.47
  },
  {
   "text": "بعضی‌هاشونم می‌گن همون چند ساعت اول!",
   "start": 14.57,
   "end": 16.85
  },
  {
   "text": "اپل هم قبول کرد که یه مشکل هست، و گفته فقط تعداد کمی از گوشی‌ها این‌طوری شدن.",
   "start": 16.99,
   "end": 22.45
  },
  {
   "text": "خبر خوب اینه که تعویضش رایگانه. حتی اگه بیمه‌ی اپل‌کِر پلاس نداشته باشی.",
   "start": 22.59,
   "end": 27.26
  },
  {
   "text": "ولی سؤال اینجاست: دو هزار دلار می‌دی، بعدش باید نگران ترک خوردنش هم باشی؟",
   "start": 27.56,
   "end": 32.98
  },
  {
   "text": "تو بودی می‌خریدیش؟ نظرت رو بنویس.",
   "start": 33.12,
   "end": 35.75
  }
 ],
